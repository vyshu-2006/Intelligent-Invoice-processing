    {
      "parameters": {
        "jsCode": "// Generate summary statistics for reporting\n\nconst invoice = $input.first().json;\n\n// Create a structured log entry\nconst logEntry = {\n  timestamp: new Date().toISOString(),\n\n  invoice_number: invoice.invoice_number || '',\n  invoice_date: invoice.invoice_date || '',\n  vendor_name: invoice.vendor_name || '',\n\n  amount: invoice.total_amount || 0,\n  currency: invoice.currency || '',\n\n  status: invoice.processing_status || '',\n  confidence: invoice.confidence_score || 0,\n\n  auto_processed: invoice.auto_approved || false,\n\n  validation_errors_count:\n    invoice.validation_errors?.length || 0,\n\n  processing_time_ms:\n    invoice.processing_timestamp\n      ? Date.now() -\n        new Date(invoice.processing_timestamp).getTime()\n      : 0,\n\n  week_number: (() => {\n    const d = new Date();\n\n    d.setHours(0, 0, 0, 0);\n\n    d.setDate(\n      d.getDate() + 3 - (d.getDay() + 6) % 7\n    );\n\n    const week1 = new Date(\n      d.getFullYear(),\n      0,\n      4\n    );\n\n    return (\n      1 +\n      Math.round(\n        (\n          (\n            d.getTime() -\n            week1.getTime()\n          ) /\n          86400000 -\n          3 +\n          (\n            week1.getDay() + 6\n          ) %\n          7\n        ) / 7\n      )\n    );\n  })()\n};\n\nreturn [\n  {\n    json: logEntry\n  }\n];"
      },
