    {
      "parameters": {
        "jsCode": "// Generate weekly analytics report\nconst allRows = $input.all().map(item => item.json);\n\n// Get current week number\nconst getWeekNumber = (d) => {\n  d = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));\n  d.setUTCDate(d.getUTCDate() + 4 - (d.getUTCDay() || 7));\n  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));\n  return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);\n};\n\nconst currentWeek = getWeekNumber(new Date());\nconst lastWeek = currentWeek - 1;\n\n// Filter last week's data\nconst lastWeekData = allRows.filter(row => parseInt(row['Week Number']) === lastWeek);\n\nconst totalProcessed = lastWeekData.length;\nconst autoApproved = lastWeekData.filter(r => r['Auto Processed'] === 'true' || r['Auto Processed'] === true).length;\nconst pendingReview = totalProcessed - autoApproved;\nconst autoApprovalRate = totalProcessed > 0 ? ((autoApproved / totalProcessed) * 100).toFixed(1) : 0;\n\n// Calculate time saved (assuming 3 min per manual invoice vs 10 sec automated)\nconst manualMinutesPerInvoice = 3;\nconst automatedSecondsPerInvoice = 10;\nconst minutesSaved = (autoApproved * manualMinutesPerInvoice) - (autoApproved * automatedSecondsPerInvoice / 60);\nconst hoursSaved = (minutesSaved / 60).toFixed(1);\n\n// Total amounts\nconst validAmounts = lastWeekData.filter(r => r['Amount'] && !isNaN(parseFloat(r['Amount'])));\nconst totalAmount = validAmounts.reduce((sum, r) => sum + parseFloat(r['Amount']), 0);\n\n// Average confidence\nconst avgConfidence = lastWeekData.length > 0\n  ? (lastWeekData.reduce((sum, r) => sum + (parseFloat(r['AI Confidence']) || 0), 0) / lastWeekData.length).toFixed(1)\n  : 0;\n\n// Top vendors\nconst vendorCounts = {};\nlastWeekData.forEach(r => {\n  if (r['Vendor']) vendorCounts[r['Vendor']] = (vendorCounts[r['Vendor']] || 0) + 1;\n});\nconst topVendors = Object.entries(vendorCounts)\n  .sort(([,a], [,b]) => b - a)\n  .slice(0, 5)\n  .map(([vendor, count]) => `${vendor}: ${count}`);\n\nreturn [{\n  json: {\n    week_number: lastWeek,\n    report_generated: new Date().toISOString(),\n    total_processed: totalProcessed,\n    auto_approved: autoApproved,\n    pending_review: pendingReview,\n    auto_approval_rate: autoApprovalRate,\n    hours_saved: hoursSaved,\n    total_invoice_amount: totalAmount.toFixed(2),\n    avg_confidence_score: avgConfidence,\n    top_vendors: topVendors.join(' | '),\n    projected_annual_hours_saved: (parseFloat(hoursSaved) * 52).toFixed(0)\n  }\n}];"
      },
