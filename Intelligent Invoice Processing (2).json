    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5",
          "mode": "list",
          "cachedResultName": "GPT-5"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an expert invoice extraction AI.\n\nExtract invoice details from this invoice text and return ONLY valid JSON.\n\nInvoice Text:\n{{ $json.text }}\n\nFields:\n{\n  \"invoice_number\": \"\",\n  \"invoice_date\": \"\",\n  \"due_date\": \"\",\n  \"vendor_name\": \"\",\n  \"vendor_email\": \"\",\n  \"vendor_phone\": \"\",\n  \"vendor_tax_id\": \"\",\n  \"bill_to_name\": \"\",\n  \"purchase_order_number\": \"\",\n  \"currency\": \"\",\n  \"subtotal\": 0,\n  \"tax_amount\": 0,\n  \"tax_rate\": 0,\n  \"discount_amount\": 0,\n  \"total_amount\": 0,\n  \"payment_terms\": \"\",\n  \"payment_method\": \"\",\n  \"notes\": \"\",\n  \"confidence_score\": 0,\n  \"line_items\": []\n}\n\nReturn ONLY JSON."
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "id": "3492c137-1758-432d-95e2-90a19b25a989",
      "name": "AI - Extract Invoice Data",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [
        -784,
        144
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response and validate extracted data\n\nconst input = $input.first().json;\n\n// GPT-4.1 jsonOutput returns structured JSON already\nlet invoiceData = input.message?.content || input;\n\n// If content is string, parse it\nif (typeof invoiceData === 'string') {\n  try {\n    const cleanedResponse = invoiceData\n      .replace(/```json\\n?/g, '')\n      .replace(/```\\n?/g, '')\n      .trim();\n\n    invoiceData = JSON.parse(cleanedResponse);\n  } catch (e) {\n    return [{\n      json: {\n        success: false,\n        error: 'Failed to parse AI response: ' + e.message,\n        raw_response: invoiceData\n      }\n    }];\n  }\n}\n\n// Validation rules\nconst validationErrors = [];\n\nif (!invoiceData.invoice_number)\n  validationErrors.push('Missing invoice number');\n\nif (!invoiceData.vendor_name)\n  validationErrors.push('Missing vendor name');\n\nif (!invoiceData.total_amount || invoiceData.total_amount <= 0)\n  validationErrors.push('Invalid or missing total amount');\n\nif (!invoiceData.invoice_date)\n  validationErrors.push('Missing invoice date');\n\n// Calculate line items subtotal\nlet calculatedSubtotal = 0;\n\nif (invoiceData.line_items && invoiceData.line_items.length > 0) {\n  calculatedSubtotal = invoiceData.line_items.reduce(\n    (sum, item) => sum + (item.total || 0),\n    0\n  );\n\n  const discrepancy = Math.abs(\n    calculatedSubtotal - (invoiceData.subtotal || 0)\n  );\n\n  if (discrepancy > 0.02) {\n    validationErrors.push(\n      `Line items sum (${calculatedSubtotal.toFixed(2)}) doesn't match subtotal (${invoiceData.subtotal})`\n    );\n  }\n}\n\n// Determine if manual review needed\nconst requiresReview =\n  validationErrors.length > 0 ||\n  (invoiceData.confidence_score &&\n    invoiceData.confidence_score < 80) ||\n  (invoiceData.total_amount &&\n    invoiceData.total_amount > 10000);\n\n// Format dates\nconst formatDate = (dateStr) => {\n  if (!dateStr) return null;\n\n  try {\n    return new Date(dateStr)\n      .toISOString()\n      .split('T')[0];\n  } catch {\n    return dateStr;\n  }\n};\n\n// Final processed data\nconst processedData = {\n  ...invoiceData,\n  invoice_date: formatDate(invoiceData.invoice_date),\n  due_date: formatDate(invoiceData.due_date),\n  validation_errors: validationErrors,\n  requires_review: requiresReview,\n  auto_approved: !requiresReview,\n  calculated_subtotal: calculatedSubtotal,\n  processing_timestamp: new Date().toISOString(),\n  processing_status: requiresReview\n    ? 'PENDING_REVIEW'\n    : 'AUTO_APPROVED'\n};\n\nreturn [{ json: processedData }];"
      },
      "id": "00c95969-dfba-4e44-a1ed-2a4e4f1bb6fd",
      "name": "Parse & Validate Invoice Data",
